<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="512dp"
    android:layout_height="662dp"
    android:padding="5dp"
    tools:context=".pages.AuthSelectFragment">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/layer_list_rect" />

    <!--  mac address  -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewMac"
        android:layout_width="450dp"
        android:layout_height="220dp"
        android:layout_marginTop="96dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMac"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/layer_list_rect_corner">

            <TextView
                android:id="@+id/textViewMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/macAdd"
                android:textSize="36dp"
                android:textStyle="bold"
                android:textColor="@color/blue_900"
                app:layout_constraintTop_toTopOf="@id/imageViewMac"
                app:layout_constraintStart_toEndOf="@id/imageViewMac"/>

            <ImageView
                android:id="@+id/imageViewMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/mac"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="contentDescription" />

            <TextView
                android:id="@+id/textViewMacContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="start"
                android:text="@string/macAddMessage"
                android:textSize="24sp"
                android:textColor="@color/gray_500"
                app:layout_constraintStart_toStartOf="@id/textViewMac"
                app:layout_constraintTop_toBottomOf="@id/textViewMac" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- member card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewMember"
        android:layout_width="450dp"
        android:layout_height="220dp"
        android:layout_marginTop="30dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardViewMac"
        app:layout_constraintStart_toStartOf="@id/cardViewMac"
        app:layout_constraintEnd_toEndOf="@id/cardViewMac" >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMember"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/layer_list_rect_corner">

            <TextView
                android:id="@+id/textViewMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/memberMessage"
                android:textSize="36dp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                app:layout_constraintTop_toTopOf="@id/imageViewMember"
                app:layout_constraintStart_toEndOf="@id/imageViewMember" />

            <ImageView
                android:id="@+id/imageViewMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/member"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="contentDescription" />

            <TextView
                android:id="@+id/textViewMemberContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="start"
                android:text="@string/memberInfoMessage"
                android:textSize="24sp"
                android:textColor="@color/gray_500"
                app:layout_constraintStart_toStartOf="@id/textViewMember"
                app:layout_constraintTop_toBottomOf="@id/textViewMember" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>